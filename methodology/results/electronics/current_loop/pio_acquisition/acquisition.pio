.program flying_chess_acquisition
.side_set 2
.wrap_target
set x, 19 side 0
bits:
out pins, 1 side 1 [3]
nop side 0 [1]
in pins, 1 side 0
nop side 0
out pins, 1 side 1 [3]
nop side 0 [1]
in pins, 1 side 0
jmp x-- bits side 0
push block side 2
pull block side 2
set y, 24 side 2 [1]
idle:
jmp y-- idle side 2 [2]
.wrap
