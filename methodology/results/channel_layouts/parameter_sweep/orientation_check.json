    "reproduction_script": "import json\nfrom pathlib import Path\nimport numpy as np\nimport levitation_sim\nfrom model import Inputs,Fixed\nfrom methodology import coil_layouts,prototype_coils,source_fingerprints\nfrom methodology.cad import magnetics\n\nroot=Path('methodology/results/channel_layouts')\ncollection_path=root/'hard_poses.json'\nsweep_path=root/'parameter_sweep/summary.json'\ncollection=json.loads(collection_path.read_text())\nsweep=json.loads(sweep_path.read_text())\nname,layout,source_angle,spacing,connection=next(row for row in Inputs.channel_layout_candidates if row[0]=='square_larger')\n_,coil,_=prototype_coils.prototype_geometry(layout)\ncandidate=next(row['candidate'] for row in sweep['results'] if row['candidate']['pattern']=='square'\n    and row['candidate']['width_mm']==coil.outer_width and row['candidate']['spacing_mm']==spacing\n    and row['candidate']['connection']==connection and row['candidate']['rotation_deg']==min(Fixed.layout_screen_rotations_deg))\nindex,pose=next((index,pose) for index,pose in enumerate(collection['poses']) if any(origin['candidate']==name\n    and origin['scope']=='all_poses' and origin['criterion']=='minimum_peak_current_A' for origin in pose['origins']))\ndelta=candidate['rotation_deg']-source_angle\nrotated=dict(pose,yaw_deg=(pose['yaw_deg']+delta)%360,tilt_direction_deg=(pose['tilt_direction_deg']+delta)%360)\nconstruction=magnetics.ConstructionModel()\ngeometry,_,_=construction(Inputs.cad_coil_layout,min(Fixed.current_demand_mesh_refinements))\nmagnet=levitation_sim.magnet_layout_from_geometry()\ncoil,winding=prototype_coils.round_wire_geometry(candidate['width_mm'],candidate['length_mm'])\narray=coil_layouts.LayoutArray(candidate['pattern'],coil,winding,candidate['rotation_deg'],min(Fixed.current_demand_mesh_refinements),spacing)\narray.window=collection['support_window_mm']/1000\nrow,_=coil_layouts.channel_pose_case(array,winding,geometry,magnet,*coil_layouts.channel_case_specification(rotated),connection=connection)\nreport=dict(scope='Rigidly rotate the known failing coil/piece alignment; recompute all world-frame demands.',\n    source_sha256=magnetics.fingerprints(),input_sha256=source_fingerprints(collection_path,sweep_path),\n    candidate=candidate,collection_pose_index=index,rotation_delta_deg=delta,result=row,\n    summary=coil_layouts.channel_case_summary([row]),reproduction_script=Path('/tmp/flying-chess-orientation-check.py').read_text())\noutput=root/'parameter_sweep/orientation_check.json'\nwith output.open('x') as handle:\n    handle.write(json.dumps(report,indent=Fixed.report_precision)+'\\n')\nprint(json.dumps(report['summary']))\n"
